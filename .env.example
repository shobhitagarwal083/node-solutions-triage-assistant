# Copy to .env and fill in ONE provider. With no key, the app runs in rules-only mode.

# --- Option A (recommended, free): Google Gemini ---
# Get a key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Option B: any OpenAI-compatible endpoint (Groq free tier, OpenRouter, local Ollama, OpenAI) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
#
# Local Ollama example (no key):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Force a provider: auto (default) | gemini | openai_compatible | rules
# TRIAGE_PROVIDER=auto
